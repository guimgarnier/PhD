\ifdefined\theorem\else \newtheorem{theorem}{\if@french Théorème\else Theorem\fi} \fi
\ifdefined\proposition\else \newtheorem{proposition}[theorem]{\if@french Proposition\else Proposition\fi} \fi
\ifdefined\corollary\else \newtheorem{corollary}[theorem]{\if@french Corollaire\else Corollary\fi} \fi
\ifdefined\lemma\else \newtheorem{lemma}[theorem]{\if@french Lemme\else Lemma\fi} \fi
\theoremstyle{definition}
\ifdefined\definition\else \newtheorem{definition}[theorem]{\if@french Définition\else Definition\fi} \fi
\ifdefined\hypothesis\else \newtheorem{hypothesis}[theorem]{\if@french Hypothèse\else Assumption\fi} \fi
\theoremstyle{remark}
\ifdefined\remark\else \newtheorem{remark}[theorem]{\if@french Remarque\else Remark\fi} \fi
\ifdefined\idea\else \newtheorem{idea}[theorem]{\if@french Idée\else Idea\fi} \fi
\ifdefined\key\else \newtheorem{key}[theorem]{\if@french Point clé\else Keypoint\fi} \fi
\ifdefined\question\else \newtheorem{question}{\if@french Question\else Question\fi} \fi
\ifdefined\toolbox\else \newtheorem{toolbox}[theorem]{\if@french Boite à outils\else Tool Box\fi} \fi
\ifdefined\example\else \newtheorem{example}[theorem]{\if@french Exemple\else Example\fi} \fi
    

