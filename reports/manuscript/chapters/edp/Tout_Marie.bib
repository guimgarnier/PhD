@ARTICLE{Legname3,
  author = {Legname, G. and Nguyen, H.-O. B. and Peretz, D. and Cohen, F. E.
	and DeArmond, S. J. and Prusiner, S. B.},
  title = {{Continuum of prion protein structures enciphers a multitude of prion
