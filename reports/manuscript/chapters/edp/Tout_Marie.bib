  journal = {Proceedings of the National Academy of Sciences},
  year = {2006},
  volume = {103},
  pages = {19105-19110},
  number = {50},
  abstract = {On passaging synthetic prions, two isolates emerged with incubation
	times differing by nearly 100 days. Using conformational-stability
	assays, we determined the guanidine hydrochloride (Gdn?·HCl) concentration
	required to denature 50% of disease-causing prion protein (PrP) molecules,
	denoted as the [Gdn?·HCl] value. For the two prion isolates enciphering
	shorter and longer incubation times, [Gdn?·HCl] values of 2.9 and
	3.7 M, respectively, were found. Intrigued by this result, we measured
	the conformational stabilities of 30 prion isolates from synthetic
	and naturally occurring sources that had been passaged in mice. When
	the incubation times were plotted as a function of the [Gdn?·HCl]
	values, a linear relationship was found with a correlation coefficient
	of 0.93. These findings demonstrate that () less stable prions replicate
	more rapidly than do stable prions, and () a continuum of PrP structural
	states enciphers a multitude of incubation-time phenotypes. Our data
	argue that cellular machinery must exist for propagating a large
	number of different PrP conformers, each of which enciphers a distinct
	biological phenotype as reflected by a specific incubation time.
	The biophysical explanation for the unprecedented plasticity of PrP
	remains to be determined.},
  doi = {10.1073/pnas.0608970103},
  eprint = {http://www.pnas.org/content/103/50/19105.full.pdf+html},
